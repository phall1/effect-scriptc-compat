{
  "compilerOptions": {
    "target": "ES2025",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "types": ["node"]
  },
  "include": ["cases/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["reports", "node_modules", "bin"]
}
